# Saras AI Environment Configuration
# Local Zero-Config SQLite Database
DATABASE_URL="file:./dev.db"

# LLM Provider 1: Local Ollama (Default: http://localhost:11434, model: gemma4:e4b)
OLLAMA_URL="http://localhost:11434"
LLM_MODEL="gemma4:e4b"

# LLM Provider 2: Cloud Gemini API calling Gemma 4
GEMINI_API_KEY="your-gemini-api-key"
GEMMA_API_MODEL_NAME="gemma-4-26b-a4b-it"
